<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan" Version="1.599" Build="17.0.4065.4"><BatchSequence><Batch><Statements><StmtSimple StatementText="SELECT s.CourseId,&#xa;       SUM(i.NetAmount) AS NetRevenue,&#xa;       COUNT(*) AS DocumentCount,&#xa;       CAST(100 * SUM(i.NetAmount) / SUM(SUM(i.NetAmount)) OVER () AS decimal(5, 2)) AS SharePct,&#xa;       CAST(100 * SUM(SUM(i.NetAmount)) OVER (ORDER BY SUM(i.NetAmount) DESC, s.CourseId&#xa;                                              ROWS UNBOUNDED PRECEDING)&#xa;                / SUM(SUM(i.NetAmount)) OVER () AS decimal(5, 2)) AS RunningSharePct&#xa;FROM Enrollment.Invoice AS i&#xa;JOIN Course.Session AS s ON s.SessionId = i.SessionId&#xa;GROUP BY s.CourseId&#xa;ORDER BY NetRevenue DESC, s.CourseId" StatementId="1" StatementCompId="1" StatementType="SELECT" StatementSqlHandle="0x0900E3922CC46691FF2487BF602BE441E11D0000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="1" ParentObjectId="0" StatementParameterizationType="0" RetrievedFromCache="true" StatementSubTreeCost="3.27409" StatementEstRows="507.1" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0xE361467C27028FE2" QueryPlanHash="0x69A445E357D30655" CardinalityEstimationModelVersion="170"><StatementSetOptions QUOTED_IDENTIFIER="true" ARITHABORT="false" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false"></StatementSetOptions><QueryPlan DegreeOfParallelism="1" MemoryGrant="7008" CachedPlanSize="120" CompileTime="3" CompileCPU="3" CompileMemory="616"><MissingIndexes><MissingIndexGroup Impact="81.0439"><MissingIndex Database="[PachadataTraining]" Schema="[Enrollment]" Table="[Invoice]"><ColumnGroup Usage="EQUALITY"><Column Name="[SessionId]" ColumnId="24"></Column></ColumnGroup><ColumnGroup Usage="INCLUDE"><Column Name="[NetAmount]" ColumnId="10"></Column></ColumnGroup></MissingIndex></MissingIndexGroup></MissingIndexes><Memo