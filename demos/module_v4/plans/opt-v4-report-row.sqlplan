<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan" Version="1.599" Build="17.0.4065.4"><BatchSequence><Batch><Statements><StmtSimple StatementText="SELECT CAST(t.ExecutedAt AS date) AS TradeDate,&#xa;           v.Code                     AS Venue,&#xa;           COUNT_BIG(*)               AS Trades,&#xa;           CAST(SUM(t.Quantity * t.Price) AS decimal(19, 2)) AS Notional&#xa;    FROM dbo.Trade AS t&#xa;    JOIN dbo.Venue AS v ON v.VenueId = t.VenueId&#xa;    WHERE t.ExecutedAt &gt;= @From&#xa;      AND t.ExecutedAt &lt;  @To&#xa;    GROUP BY CAST(t.ExecutedAt AS date), v.Code&#xa;    ORDER BY TradeDate, Venue&#xa;    OPTION (USE HINT (&apos;DISALLOW_BATCH_MODE&apos;))" StatementId="1" StatementCompId="4" StatementType="SELECT" StatementSqlHandle="0x0900598738F565B875E9651211A77B11A9B50000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="1" ParentObjectId="658101385" StatementParameterizationType="0" RetrievedFromCache="true" StatementSubTreeCost="274.329" StatementEstRows="560875" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0x9FCF7D3BBCDCF383" QueryPlanHash="0x4E55F87D7029A398" CardinalityEstimationModelVersion="170"><StatementSetOptions QUOTED_IDENTIFIER="true" ARITHABORT="false" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false"></StatementSetOptions><QueryPlan DegreeOfParallelism="2" MemoryGrant="9232" CachedPlanSize="104" CompileTime="113" CompileCPU="9" CompileMemory="744"><ThreadStat Branches="2" UsedThreads="4"><ThreadReservation NodeId="1" ReservedThreads="4"></ThreadReservation></ThreadStat><MissingIndexes><MissingIndexGroup Impact="29.8314"><MissingIndex Database="[LuminaQuant_v4]" Schema="[dbo]" Table="[Trade]"><ColumnGroup Usage="INEQUALITY"><Column Name="[ExecutedAt]" ColumnId="8"></Column></ColumnGroup><ColumnGroup Usage="INCLUDE"><Column Name="[VenueId]" ColumnId="4"></Column><Column Name="[Notional]" Column