<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan" Version="1.599" Build="17.0.4065.4"><BatchSequence><Batch><Statements><StmtSimple StatementText="SELECT CASE a.Device WHEN &apos;O&apos; THEN &apos;Computer&apos; WHEN &apos;M&apos; THEN &apos;Mobile&apos; WHEN &apos;T&apos; THEN &apos;Tablet&apos; ELSE a.Device END AS Device,&#xa;           DATEADD(day, DATEDIFF(day, &apos;19000101&apos;, a.EventTime) / 7 * 7, &apos;19000101&apos;) AS WeekStart,&#xa;           COUNT(*) AS Events,&#xa;           COUNT(DISTINCT a.ContactId) AS Learners,&#xa;           CAST(SUM(CAST(a.DurationSeconds AS bigint)) / 3600.0 AS decimal(12, 1)) AS HoursSpent&#xa;    FROM Elearning.Activity AS a&#xa;    WHERE a.EventTime &gt;= @Start AND a.EventTime &lt; DATEADD(day, 1, @End)&#xa;    GROUP BY a.Device, DATEADD(day, DATEDIFF(day, &apos;19000101&apos;, a.EventTime) / 7 * 7, &apos;19000101&apos;)&#xa;    ORDER BY WeekStart, Device" StatementId="1" StatementCompId="4" StatementType="SELECT" StatementSqlHandle="0x09000DDC74D890758DC58ABF332B001026880000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="1" ParentObjectId="1401108082" StatementParameterizationType="0" RetrievedFromCache="true" StatementSubTreeCost="29.5895" StatementEstRows="376092" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0xA29EBE9255129A3E" QueryPlanHash="0x81FBC68465CCAB03" CardinalityEstimationModelVersion="170" BatchModeOnRowStoreUsed="true"><StatementSetOptions QUOTED_IDENTIFIER="false" ARITHABORT="false" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false"></StatementSetOptions><QueryPlan DegreeOfParallelism="22" MemoryGrant="189432" CachedPlanSize="96" CompileTime="32" CompileCPU="22" CompileMemory="1928"><ThreadStat Branches="1" UsedThreads="22"><ThreadReservation NodeId="0" ReservedThreads="12"></ThreadReservation><ThreadReservation NodeId="1" ReservedThreads="11"></ThreadReservati